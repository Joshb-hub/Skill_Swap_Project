# SkillSwap Backend Environment Variables

PROJECT_NAME="SkillSwap"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api"

# Secret Key (Generate with: openssl rand -hex 32)
SECRET_KEY="skillswap-super-secret-development-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database URL
# PostgreSQL (Production target): postgresql+asyncpg://<username>:<password>@<host>:5432/<database>
# SQLite fallback for local development only when DATABASE_URL is unset: sqlite+aiosqlite:///./skillswap.db
DATABASE_URL="postgresql+asyncpg://<username>:<password>@<host>:5432/<database>"

# Redis URL (Rate limiting, session tracking, websocket PubSub)
# Set to empty or None to use resilient In-Memory Manager fallback
REDIS_URL="redis://localhost:6379/0"

# Security & Rate Limiting
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_LOCKOUT_DURATION_MINUTES=15

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Uploads directory
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=10
